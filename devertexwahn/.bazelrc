#-------------------------------------------------------------------------------------
# Bazel 8 migration
#-------------------------------------------------------------------------------------

common --incompatible_disallow_empty_glob=false  # TODO: Get rid of this - Set empty globs allowed policy explicitly where needed

#-------------------------------------------------------------------------------------
# Bzlmod
#-------------------------------------------------------------------------------------

#common --registry=file:///%workspace%/registry
common --registry=https://bcr.bazel.build


#-------------------------------------------------------------------------------------
# C++ compiler settings
#-------------------------------------------------------------------------------------

build --@boost.asio//:ssl=boringssl

# macOS
build:macos --macos_minimum_os=10.15
build:macos --features=-use_header_modules  # Apple Clang 17+ in Bazel can incorrectly enable header module mode for libc++ and abseil; disable it globally on macOS.
build:macos --cxxopt=-std=c++23  # see https://clang.llvm.org/cxx_status.html
build:macos --cxxopt=-Wall  # Turn on all warnings
build:macos --cxxopt=-Wno-error=implicit-function-declaration  # Qt qyieldcpu.h calls __yield() without including <arm_acle.h>
#build:macos --sandbox_block_path=/usr/local # This will fix okapi.cli but break okapi.ui - Note: Workaround for https://github.com/bazelbuild/bazel/issues/10472 - compile error with boringssl
build:macos --define compiler=macos
#build:macos --noincompatible_enable_cc_toolchain_resolution  # disable LLVM toolchain
#build:macos --cxxopt=-Werror # Commented out because of Embree
#build:macos --cxxopt=-Wextra
#build:macos --spawn_strategy=local

# GCC 15
build:gcc15 --cxxopt=-std=c++23
build:gcc15 --cxxopt=-Wall
build:gcc15 --define compiler=gcc15
build:gcc15 --cxxopt=-fpermissive # Needed for fmt



# Clang 14.0.0 (config is used on Ubuntu)
build:clang14 --cxxopt=-std=c++20
#build:clang14 --cxxopt=-mavx
#build:clang14 --cxxopt=-mavx2
#build:clang14 --cxxopt=-msse4.2
#build:clang14 --cxxopt=-Werror
build:clang14 --incompatible_enable_cc_toolchain_resolution
# Tell Bazel to pass the right flags for llvm-ar, not libtool. Only needed if you are building on darwin.
# See https://github.com/bazelbuild/bazel/blob/5c75d0acec21459bbb13520817e3806e1507e907/tools/cpp/unix_cc_toolchain_config.bzl#L1000-L1024
build:clang14 --features=-libtool
build:clang14 --cxxopt=-mwaitpkg
build:clang14 --define compiler=clang14

# Visual Studio 2026
#build:vs2026 --copt=-DNOGDI
#build:vs2026 --cxxopt=/std:c++20
#build:vs2026 --host_copt=-DNOGDI


build:vs2026 --copt=-DWIN32_LEAN_AND_MEAN
build:vs2026 --cxxopt=/std:c++latest # Support for C++23 features
build:vs2026 --cxxopt=/utf-8
build:vs2026 --cxxopt=/Zc:__cplusplus
build:vs2026 --cxxopt=/Zc:preprocessor # needed for __VA_OPT__ macro
build:vs2026 --define compiler=vs2026
build:vs2026 --enable_runfiles # https://github.com/bazelbuild/bazel/issues/8843
build:vs2026 --host_copt=-DWIN32_LEAN_AND_MEAN
build:vs2026 --action_env=PATH # powershell.exe must be reachable for rules_python build_data_writer.ps1
# NOTE: The Bazel server inherits PATH from the invoking shell. If Python targets fail with
# "powershell.exe not found", ensure C:\Windows\System32\WindowsPowerShell\v1.0 is in PATH,
# then run: bazel shutdown && bazel build ...
# Genrules run via MSYS2 bash (BAZEL_SH) also take their tools from this PATH. If they fail with
# "cp: command not found" (Exit 127), add <MSYS2 root>\usr\bin (e.g. C:\msys64\usr\bin) to PATH.


build:windows --config=vs2026

# Address Sanitizer
build:asan --config=gcc9
build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -O1
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address

# clang-tidy
build:clang-tidy --aspects @bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=report

# Optimized build
build:optimized build --copt=-O3

# IWYU
# More details here: https://github.com/storypku/bazel_iwyu/pull/12
#build:iwyu --@bazel_iwyu//:iwyu_mappings=@my_repo//tools:iwyu_mappings
build:iwyu --config=gcc15
#build:iwyu --config=clang19
build:iwyu --aspects @bazel_iwyu//bazel/iwyu:iwyu.bzl%iwyu_aspect
build:iwyu --output_groups=report
build:iwyu --build_tag_filters=-no-iwyu # To include everything except the rules tagged with "no-iwyu"
build:iwyu --@bazel_iwyu//:iwyu_opts=--verbose=3,--no_fwd_decls,--cxx17ns,--max_line_length=127

# Emscripten
build:emscripten --features=exceptions
build:emscripten --incompatible_enable_cc_toolchain_resolution

try-import %workspace%/bazel/bazelrc/.bazelrc.remote_cache
try-import %workspace%/bazel/bazelrc/.bazelrc.build_meta

# LLVM toolchain for Bazel

build:llvm_toolchain --cxxopt=-std=c++20

# LLVM toolchain on Ubuntu
build:llvm_toolchain_ubuntu --config=llvm_toolchain
build:llvm_toolchain_ubuntu --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:llvm_toolchain_ubuntu --features=-libtool
build:llvm_toolchain_ubuntu --cxxopt=-mwaitpkg
build:llvm_toolchain_ubuntu --define compiler=clang21

build:clang21 --config=llvm_toolchain_ubuntu
# Note: On Ubuntu 25.10+/Debian trixie+ the prebuilt LLVM binaries (lld, ...)
# require libxml2.so.2, which the system no longer ships. Run once:
#   sudo bazel/llvm_toolchain/setup_libxml2_compat.sh

# LLVM toolchain on macOS
build:llvm_toolchain_macos --config=llvm_toolchain
#build:llvm_toolchain_macos --extra_toolchains=@llvm_toolchain//:cc-toolchain-darwin

#-------------------------------------------------------------------------------------
# Python
#-------------------------------------------------------------------------------------

# Do not synthesize missing __init__.py files in the runfiles tree. Every Python
# package must ship its __init__.py explicitly in the srcs of its py_* targets.
# See https://github.com/bazel-contrib/rules_python/issues/2945
build --incompatible_default_to_explicit_init_py=true

#-------------------------------------------------------------------------------------
# Machine-local settings (e.g. output_base, disk_cache) - .bazelrc.local is git-ignored
#-------------------------------------------------------------------------------------

# Keep this last so that local settings take precedence
try-import %workspace%/.bazelrc.local
