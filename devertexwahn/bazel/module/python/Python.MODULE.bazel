bazel_dep(name = "rules_python", version = "2.5.1")

# Opt out of the deprecated implicit __init__.py creation for all py_* targets of this module.
# See https://github.com/bazel-contrib/rules_python/issues/2945
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

PYTHON_VERSION = "3.13.2"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = PYTHON_VERSION)
use_repo(
    python,
    python_3_13 = "python_3_13_2",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    experimental_requirement_cycles = {
        "sphinx": [
            "sphinx",
            "sphinxcontrib-serializinghtml",
            "sphinxcontrib-qthelp",
            "sphinxcontrib-htmlhelp",
            "sphinxcontrib-devhelp",
            "sphinxcontrib-applehelp",
        ],
    },
    hub_name = "de_vertexwahn_pypi",
    python_version = PYTHON_VERSION,
    requirements_darwin = "//bazel/module/python:requirements_darwin.txt",
    requirements_linux = "//bazel/module/python:requirements_linux.txt",
    requirements_lock = "//bazel/module/python:requirements_lock.txt",
    requirements_windows = "//bazel/module/python:requirements_windows.txt",
)

# The hub name "pypi" is reserved for rules_python's unified hub, so the hub has a module-specific
# name and is mapped back to the short local name @pypi used throughout this repository.
use_repo(pip, pypi = "de_vertexwahn_pypi")
